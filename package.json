{
  "name": "web-chess-game",
  "version": "1.0.0",
  "private": true,
  "description": "Browser chess game (vanilla JS, no build step). package.json exists only for the test suite.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:slow": "RUN_SLOW=1 node --test --test-concurrency=1 \"tests/slow/*.test.js\""
  },
  "devDependencies": {
    "gsap": "3.12.2",
    "jsdom": "^24.1.3"
  }
}
